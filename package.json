{
  "name": "terravalue-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"cyan,blue\" \"cd backend && python -m uvicorn app.main:app --port 8000 --reload\" \"npm --prefix frontend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
